# EMBER — frontend environment.
#
# Copy to `frontend/.env.local`. Vite only exposes vars prefixed with VITE_.
# ⚠️  Anything here ships to the browser. NEVER put a secret in this file —
#     server-side keys (Google, Anthropic, FIRMS, Mireye) belong in backend/.

# ── Backend URL ─────────────────────────────────────────────────────────────
# Leave BLANK for local dev — Vite proxies /api to localhost:8787 (see
# vite.config.ts), which also avoids CORS entirely.
# In production set this to the Render backend URL, e.g.
#   VITE_API_URL=https://ember-api.onrender.com
VITE_API_URL=

# ── Mapbox ──────────────────────────────────────────────────────────────────
# Public token (pk.*). WITHOUT THIS THE APP STILL WORKS: MapView falls back to
# a token-free SVG schematic that draws the fire, both routes and your house.
# Restrict the token to your domains before shipping.
VITE_MAPBOX_TOKEN=
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/dark-v11
