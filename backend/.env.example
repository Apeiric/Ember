# EMBER — backend environment.
#
# Copy to `backend/.env.local` and fill in what you have.
# NEVER commit a filled-in file. `.env.local` is gitignored.
#
# ⚠️  ON RENDER: set these in the service's Environment tab, not just here.
#     Forgetting that is a classic demo-day failure — CONTEXT.md §8.
#
# EVERY KEY BELOW IS OPTIONAL. A missing key disables that provider and the
# pipeline falls through to the next strategy, ending in canned demo data.
# The app boots, serves, and demos correctly with this file entirely empty.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated allowlist. Leave blank to allow any origin (fine locally).
CORS_ORIGINS=

# ── Google: geocoding + directions (one key, both APIs enabled) ─────────────
# Enable "Geocoding API" and "Directions API" on the same project.
GOOGLE_MAPS_API_KEY=

# ── NASA FIRMS: satellite hotspots ──────────────────────────────────────────
# Free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_FIRMS_API_KEY=

# ── Mireye: terrain, slope, roads out ───────────────────────────────────────
MIREYE_API_KEY=
MIREYE_BASE_URL=https://api.mireye.ai

# ── Anthropic: writes the verdict prose ─────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── Groq: fast fallback writer ──────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Demo controls ───────────────────────────────────────────────────────────
# Set to true before you walk on stage if the venue wifi is hostile. Every
# stage then uses canned data and the demo is byte-for-byte reproducible.
EMBER_FORCE_OFFLINE=false
EMBER_DEFAULT_SCENARIO=palisades-2025

# NIFC perimeters and NWS wind need no key — they are always available.
